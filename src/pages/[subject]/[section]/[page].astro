---
// A lesson page. The layout does the frame; the MDX file gives the words.
import { render } from 'astro:content';
import LessonLayout from '../../../layouts/LessonLayout.astro';
import { lessonComponents } from '@components/mdx';
import { getLibrary, type Page, type Section, type Subject } from '@lib/content';

export async function getStaticPaths() {
  const subjects = await getLibrary();
  return subjects.flatMap((subject) =>
    subject.sections.flatMap((section) =>
      section.pages.map((page) => ({ params: { subject: subject.slug, section: section.slug, page: page.slug }, props: { subject, section, page } })),
    ),
  );
}
interface Props { subject: Subject; section: Section; page: Page }
const { subject, section, page } = Astro.props;
const { Content } = await render(page.entry);
---
<LessonLayout subject={subject} section={section} page={page}>
  <Content components={lessonComponents} />
</LessonLayout>
