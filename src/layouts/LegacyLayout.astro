---
/**
 * An older lesson (a single HTML file or a multi-file app) opens AS ITSELF: the original file,
 * unchanged, as a full page of its own. No site header, no frame, no box around it, so every
 * animation, layout and interaction behaves exactly as in the original.
 *
 * This page only (1) clears what older lessons saved last time, so each one starts fresh, and
 * (2) swaps itself for the original file. Because it uses location.replace, the browser's Back
 * button goes straight back to the library page the lesson was opened from.
 */
import type { Page } from '@lib/content';
import { url } from '@lib/url';

interface Props { page: Page }
const { page } = Astro.props;
const src = url(page.data.legacy!.replace(/^\//, ''));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{page.data.title}</title>
    <script define:vars={{ src }}>
      try {
        var keep = { 'library.theme': 1 };
        for (var i = localStorage.length - 1; i >= 0; i--) { var k = localStorage.key(i); if (!keep[k]) localStorage.removeItem(k); }
        sessionStorage.clear();
      } catch (e) { /* storage blocked: nothing saved to clear */ }
      location.replace(src);
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${src}`} /></noscript>
    <style>body { font: 18px/1.5 system-ui, sans-serif; margin: 2rem; }</style>
  </head>
  <body>
    <p>Opening <a href={src}>{page.data.title}</a>…</p>
  </body>
</html>
