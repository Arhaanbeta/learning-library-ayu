---
// Previous / next lesson in the same folder. On the last lesson, "next" goes back to the folder.
import type { Folder, Page } from '@lib/content';
interface Props { prev?: Page; next?: Page; folder: Folder }
const { prev, next, folder } = Astro.props;
---
<nav class="prevnext" aria-label="More lessons">
  {prev ? <a class="pn prev" href={prev.href} rel="prev"><span class="meta">‹ Previous</span><span class="t">{prev.data.title}</span></a> : <span />}
  {next
    ? <a class="pn next" href={next.href} rel="next"><span class="meta">Next ›</span><span class="t">{next.data.title}</span></a>
    : <a class="pn next" href={folder.href}><span class="meta">Finished this part</span><span class="t">Back to {folder.title}</span></a>}
</nav>

<style>
  .prevnext { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-top: var(--space-7); max-width: var(--measure); }
  .pn {
    display: flex; flex-direction: column; gap: 2px; padding: var(--space-4); min-height: var(--tap);
    background: var(--surface); border: var(--border); border-radius: var(--radius); text-decoration: none; color: var(--ink);
  }
  .pn:hover { border-color: var(--accent); }
  .next { text-align: right; grid-column: 2; }
  .t { font-weight: 700; color: var(--accent-ink); }
</style>
