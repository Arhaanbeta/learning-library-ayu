---
// One folder in the library map, with its lessons and its sub-folders (drawn by calling itself).
import { allPages, plural, type Folder } from '@lib/content';
interface Props { folder: Folder }
const { folder } = Astro.props;
---
<li class="branch" data-accent={folder.accent}>
  <a class="fname" href={folder.href}>{folder.icon && <span aria-hidden="true">{folder.icon} </span>}{folder.title}</a>
  <span class="meta"> · {plural(allPages(folder).length, 'lesson')}</span>
  {(folder.pages.length > 0 || folder.folders.length > 0) && (
    <ul role="list">
      {folder.pages.map((p) => <li class="leaf"><a href={p.href}>{p.data.title}</a>{p.data.legacy && <span class="meta"> · interactive</span>}</li>)}
      {folder.folders.map((f) => <Astro.self folder={f} />)}
    </ul>
  )}
</li>

<style>
  .branch { margin-top: var(--space-3); }
  .fname { font-weight: 700; color: var(--accent-ink); text-decoration: none; font-size: var(--text-lg); }
  .fname:hover { text-decoration: underline; }
  ul { list-style: none; margin: var(--space-1) 0 0; padding-left: var(--space-5); border-left: 3px solid var(--accent-soft); }
  .leaf { padding: var(--space-1) 0; }
  .leaf a { color: var(--ink); }
  .branch .branch .fname { font-size: var(--text-base); }
</style>
