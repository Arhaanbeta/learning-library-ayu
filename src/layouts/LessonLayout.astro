---
/**
 * A written lesson: breadcrumb, the folder's other lessons in a sidebar, the lesson,
 * and previous/next links. Always opens at the top; nothing about the reader is remembered.
 */
import 'katex/dist/katex.min.css';
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SectionNav from '@components/SectionNav.astro';
import PrevNext from '@components/PrevNext.astro';
import CopyButtons from '@components/CopyButtons.astro';
import { ancestors, neighbours, type Page } from '@lib/content';

interface Props { page: Page }
const { page } = Astro.props;
const folder = page.folder;
const { prev, next } = neighbours(page);
const n = folder.pages.indexOf(page) + 1;
---
<BaseLayout title={page.data.title} description={page.data.summary} accent={folder.accent}>
  <Breadcrumb trail={[...ancestors(folder).map((f) => ({ label: f.title, href: f.href })), { label: page.data.title }]} />
  <div class="lesson">
    <SectionNav folder={folder} current={page.id} />
    <article>
      <header class="lesson-head">
        <p class="eyebrow">{folder.title} · Lesson {n} of {folder.pages.length}</p>
        <h1>{page.data.title}</h1>
        {page.data.summary && <p class="lead">{page.data.summary}</p>}
        {page.data.minutes && <p class="meta">About {page.data.minutes} minutes</p>}
      </header>
      <div class="prose">
        <slot />
      </div>
      <PrevNext prev={prev} next={next} folder={folder} />
    </article>
    <CopyButtons />
  </div>
</BaseLayout>

<style>
  .lesson { display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); margin-top: var(--space-4); }
  @media (min-width: 62rem) { .lesson { grid-template-columns: var(--sidebar) minmax(0, 1fr); align-items: start; } }
  .lesson-head { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-6); max-width: var(--measure); }
  h1 { font-size: var(--text-2xl); }
</style>
