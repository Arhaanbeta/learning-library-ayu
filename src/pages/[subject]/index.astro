---
// Subject home: its sections, each with its pages count (progress bars arrive in Phase 2).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getLibrary, plural, totalMinutes, type Subject } from '@lib/content';

export async function getStaticPaths() {
  const subjects = await getLibrary();
  return subjects.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}
interface Props { subject: Subject }
const { subject } = Astro.props;
---
<BaseLayout title={subject.title} description={subject.blurb} accent={subject.accent}>
  <Breadcrumb trail={[{ label: subject.title }]} />
  <header class="head">
    <span class="icon" aria-hidden="true">{subject.icon}</span>
    <h1>{subject.title}</h1>
    <p class="lead">{subject.blurb}</p>
  </header>
  <ol class="sections" role="list">
    {subject.sections.map((sec, i) => (
      <li>
        <a class="sec card" href={sec.href} data-section={`${subject.slug}/${sec.slug}`}>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <span class="body">
            <span class="name">{sec.title}</span>
            <span class="summary">{sec.summary}</span>
            <span class="meta">{plural(sec.pages.length, 'page')} · about {totalMinutes(sec.pages)} minutes</span>
            <!-- Phase 2: progress bar for this section -->
            <span class="bar" data-progress-for={sec.pages.map((p) => p.id).join(' ')} hidden><i></i></span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  {subject.sections.length === 0 && <p class="lead">No sections yet.</p>}
</BaseLayout>

<style>
  .head { display: flex; flex-direction: column; gap: var(--space-2); margin: var(--space-4) 0 var(--space-6); }
  .icon { font-size: 3rem; line-height: 1; }
  h1 { font-size: var(--text-2xl); }
  .sections { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-4); max-width: 48rem; }
  .sec { display: flex; gap: var(--space-4); padding: var(--space-5); text-decoration: none; color: var(--ink); border-left: 6px solid var(--accent); }
  .sec:hover { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft), var(--shadow); }
  .num {
    flex: 0 0 auto; display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: var(--accent-soft); color: var(--accent-ink); font-weight: 700; font-size: var(--text-lg);
  }
  .body { display: flex; flex-direction: column; gap: var(--space-1); }
  .name { font-size: var(--text-lg); font-weight: 700; color: var(--accent-ink); }
  .summary { color: var(--ink-2); }
  .bar { display: block; height: 8px; border-radius: 4px; background: var(--surface-2); overflow: hidden; margin-top: var(--space-2); }
  .bar i { display: block; height: 100%; width: 0; background: var(--accent); }
</style>
